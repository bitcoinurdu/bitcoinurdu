'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import Image from 'next/image';
import { formatCurrency, formatNumber, formatPercent } from '@/lib/utils/helpers';
import { useAppStore } from '@/stores';
import {
  ArrowUpRight,
  ArrowDownRight,
  TrendingUp,
  BarChart3,
  Coins,
  Globe,
  Flame,
  ChevronLeft,
  ChevronRight,
  Search,
  ArrowUpDown,
} from 'lucide-react';

const PER_PAGE = 50;

interface HomePageClientProps {
  globalData: Record<string, unknown> | null;
  coins: (Record<string, unknown> & { usd_price: number })[];
  trendingData: Record<string, unknown> | null;
  fearGreedData: Record<string, unknown> | null;
  tickerCoins: (Record<string, unknown> & { usd_price: number })[];
}

export default function HomePageClient({
  globalData,
  coins,
  trendingData,
  fearGreedData,
  tickerCoins,
}: HomePageClientProps) {
  const { currency } = useAppStore();
  const [search, setSearch] = useState('');
  const [page, setPage] = useState(1);
  const [filter, setFilter] = useState<'all' | 'gainers' | 'losers'>('all');
  const [liveCoins, setLiveCoins] = useState(coins);
  const [lastUpdate, setLastUpdate] = useState(new Date());

  useEffect(() => {
    const interval = setInterval(() => {
      Promise.all([
        fetch('https://api.coingecko.com/api/v3/coins/markets?vs_currency=pkr&order=market_cap_desc&per_page=100&page=1&sparkline=false&price_change_percentage=1h,24h,7d').then((r) => r.json()),
        fetch('https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=100&page=1&sparkline=false').then((r) => r.json()),
      ])
        .then(([pkrData, usdData]) => {
          const usdMap: Record<string, number> = {};
          usdData.forEach((c: Record<string, unknown>) => { usdMap[c.id as string] = c.current_price as number; });
          const merged = pkrData.map((c: Record<string, unknown>) => ({
            ...c,
            usd_price: usdMap[c.id as string] || 0,
          }));
          setLiveCoins(merged);
          setLastUpdate(new Date());
        })
        .catch(() => {});
    }, 60000);
    return () => clearInterval(interval);
  }, []);

  const data = globalData?.data as Record<string, unknown> | undefined;
  const marketCap = (data?.total_market_cap as Record<string, number>)?.pkr || 0;
  const volume = (data?.total_volume as Record<string, number>)?.pkr || 0;
  const btcDom = ((data?.market_cap_percentage as Record<string, number>)?.btc || 0).toFixed(1);
  const mcapChange = (data?.market_cap_change_percentage_24h_usd as number) || 0;
  const activeCoins = data?.active_cryptocurrencies || 0;

  const fgiData = fearGreedData as Record<string, unknown[]> | undefined;
  const fgiArray = fgiData?.data as Record<string, string>[] | undefined;
  const fgi = fgiArray?.[0];
  const fgiValue = fgi ? parseInt(fgi.value) : 0;
  const fgiLabel = fgi?.value_classification || 'N/A';
  const fgiColor = fgiValue < 25 ? 'text-red-500' : fgiValue < 50 ? 'text-orange-500' : fgiValue < 75 ? 'text-yellow-500' : 'text-green-500';

  const trendingItems = (trendingData as Record<string, unknown[]>)?.coins || [];

  let filtered = coins.filter((c) =>
    (c.name as string).toLowerCase().includes(search.toLowerCase()) ||
    (c.symbol as string).toLowerCase().includes(search.toLowerCase())
  );

  if (filter === 'gainers') {
    filtered = [...filtered].sort((a, b) => ((b.price_change_percentage_24h as number) || 0) - ((a.price_change_percentage_24h as number) || 0));
  } else if (filter === 'losers') {
    filtered = [...filtered].sort((a, b) => ((a.price_change_percentage_24h as number) || 0) - ((b.price_change_percentage_24h as number) || 0));
  }

  const totalPages = Math.ceil(filtered.length / PER_PAGE);
  const pagedCoins = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);

  return (
    <div className="space-y-0">
      {/* TICKER */}
      <div className="border-b bg-muted/30 overflow-hidden py-2">
        <div className="flex gap-6 animate-marquee whitespace-nowrap">
          {[...tickerCoins, ...tickerCoins].map((c, i) => (
            <Link
              key={`${c.id}-${i}`}
              href={`/coins/${c.id}`}
              className="inline-flex items-center gap-2 shrink-0 text-xs hover:opacity-80"
            >
              <Image
                src={c.image as string}
                alt={c.symbol as string}
                width={16}
                height={16}
                className="rounded-full"
              />
              <span className="font-medium">{(c.symbol as string).toUpperCase()}</span>
              <span>{formatPKR(c.current_price as number)}</span>
              <span className={(c.price_change_percentage_24h as number) >= 0 ? 'text-crypto-green' : 'text-crypto-red'}>
                {(c.price_change_percentage_24h as number) >= 0 ? '+' : ''}{formatPercent(Math.abs(c.price_change_percentage_24h as number || 0))}
              </span>
            </Link>
          ))}
        </div>
      </div>

      {/* HERO */}
      <section className="bg-gradient-to-br from-bitcoin/10 via-background to-bitcoin/5 border-b p-8 md:p-12">
        <div className="max-w-7xl mx-auto">
          <h1 className="text-3xl md:text-4xl font-bold text-center mb-2">
            Pakistan Ka #1 <span className="text-bitcoin">Crypto</span> Platform
          </h1>
          <p className="text-muted-foreground text-center mb-8">
            Real-time Bitcoin, Ethereum aur 10,000+ coins ki PKR prices
          </p>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
            <div className="text-center">
              <div className="text-xl font-bold">{formatPKR((coins[0]?.current_price as number) || 0)}</div>
              <div className="text-xs text-muted-foreground">Bitcoin (PKR)</div>
            </div>
            <div className="text-center">
              <div className="text-xl font-bold">{formatPKR(marketCap)}</div>
              <div className="text-xs text-muted-foreground">Global Market Cap</div>
            </div>
            <div className="text-center">
              <div className="text-xl font-bold">{btcDom}%</div>
              <div className="text-xs text-muted-foreground">BTC Dominance</div>
            </div>
            <div className="text-center">
              <div className="text-xl font-bold">{formatNumber(activeCoins as number, 0)}</div>
              <div className="text-xs text-muted-foreground">Cryptocurrencies</div>
            </div>
          </div>
        </div>
      </section>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* MARKET CARDS */}
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div className="rounded-xl border bg-card p-4">
            <h3 className="text-sm text-muted-foreground mb-1">Total Market Cap</h3>
            <div className="text-lg font-bold">{formatPKR(marketCap)}</div>
            <div className={`text-xs ${mcapChange >= 0 ? 'text-crypto-green' : 'text-crypto-red'}`}>
              {mcapChange >= 0 ? '+' : ''}{mcapChange.toFixed(2)}% (24h)
            </div>
          </div>
          <div className="rounded-xl border bg-card p-4">
            <h3 className="text-sm text-muted-foreground mb-1">24h Volume</h3>
            <div className="text-lg font-bold">{formatPKR(volume)}</div>
            <div className="text-xs text-muted-foreground">Global Trading</div>
          </div>
          <div className="rounded-xl border bg-card p-4">
            <h3 className="text-sm text-muted-foreground mb-1">BTC Dominance</h3>
            <div className="text-lg font-bold">{btcDom}%</div>
            <div className="text-xs text-muted-foreground">Market Share</div>
          </div>
          <div className="rounded-xl border bg-card p-4">
            <h3 className="text-sm text-muted-foreground mb-1">Active Coins</h3>
            <div className="text-lg font-bold">{formatNumber(activeCoins as number, 0)}</div>
            <div className="text-xs text-muted-foreground">Tracked by BitcoinUrdu</div>
          </div>
        </div>

        {/* AD BANNER */}
        <div className="rounded-xl border border-dashed border-muted-foreground/20 bg-muted/30 py-6 px-4 text-center mb-8">
          <span className="text-sm text-muted-foreground">📢 اشتہار — </span>
          <Link href="/advertise" className="text-sm text-bitcoin hover:underline">یہاں اشتہار لگائیں</Link>
        </div>

        <div className="space-y-8">
          {/* COINS TABLE */}
          <div>
            <h2 className="text-xl font-bold mb-4">🔥 Top Cryptocurrencies <span className="text-muted-foreground font-normal">By Market Cap</span></h2>
              <div className="flex gap-2 mb-4">
                <div className="relative flex-1">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                  <input
                    type="text"
                    placeholder="Search coin..."
                    value={search}
                    onChange={(e) => { setSearch(e.target.value); setPage(1); }}
                    className="w-full pl-10 pr-4 py-2 rounded-lg border bg-background text-sm focus:outline-none focus:ring-2 focus:ring-bitcoin/50"
                  />
                </div>
                <select
                  value={filter}
                  onChange={(e) => { setFilter(e.target.value as 'all' | 'gainers' | 'losers'); setPage(1); }}
                  className="px-3 py-2 rounded-lg border bg-background text-sm focus:outline-none"
                >
                  <option value="all">All Coins</option>
                  <option value="gainers">Top Gainers</option>
                  <option value="losers">Top Losers</option>
                </select>
              </div>

              <div className="overflow-x-auto rounded-xl border">
                <table className="w-full text-sm">
                  <thead className="bg-muted/50">
                    <tr>
                      <th className="py-3 px-3 text-left font-medium">#</th>
                      <th className="py-3 px-3 text-left font-medium">Coin</th>
                      <th className="py-3 px-3 text-right font-medium">Price (PKR)</th>
                      <th className="py-3 px-3 text-right font-medium hidden sm:table-cell">Price (USD)</th>
                      <th className="py-3 px-3 text-right font-medium hidden md:table-cell">1h %</th>
                      <th className="py-3 px-3 text-right font-medium">24h %</th>
                      <th className="py-3 px-3 text-right font-medium hidden md:table-cell">7d %</th>
                      <th className="py-3 px-3 text-right font-medium hidden lg:table-cell">Market Cap</th>
                      <th className="py-3 px-3 text-right font-medium hidden lg:table-cell">24h Vol</th>
                    </tr>
                  </thead>
                  <tbody>
                    {pagedCoins.map((c, i) => {
                      const h1 = c.price_change_percentage_1h_in_currency as number | undefined;
                      const h24 = c.price_change_percentage_24h as number | undefined;
                      const h7 = c.price_change_percentage_7d_in_currency as number | undefined;
                      return (
                        <tr
                          key={c.id as string}
                          className="border-t hover:bg-muted/50 cursor-pointer transition-colors"
                          onClick={() => window.location.href = `/coins/${c.id}`}
                        >
                          <td className="py-3 px-3 text-muted-foreground">{(page - 1) * PER_PAGE + i + 1}</td>
                          <td className="py-3 px-3">
                            <div className="flex items-center gap-2">
                              <Image
                                src={c.image as string}
                                alt={c.symbol as string}
                                width={28}
                                height={28}
                                className="rounded-full"
                              />
                              <div>
                                <div className="font-medium">{c.name as string}</div>
                                <div className="text-xs text-muted-foreground uppercase">{c.symbol as string}</div>
                              </div>
                            </div>
                          </td>
                          <td className="py-3 px-3 text-right font-semibold">{formatPKR(c.current_price as number)}</td>
                          <td className="py-3 px-3 text-right hidden sm:table-cell">{formatUSD(c.usd_price)}</td>
                          <td className={`py-3 px-3 text-right hidden md:table-cell ${pctClass(h1)}`}>{pctStr(h1)}</td>
                          <td className={`py-3 px-3 text-right ${pctClass(h24)}`}>{pctStr(h24)}</td>
                          <td className={`py-3 px-3 text-right hidden md:table-cell ${pctClass(h7)}`}>{pctStr(h7)}</td>
                          <td className="py-3 px-3 text-right hidden lg:table-cell">{formatPKR(c.market_cap as number)}</td>
                          <td className="py-3 px-3 text-right hidden lg:table-cell">{formatPKR(c.total_volume as number)}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              {/* PAGINATION */}
              {totalPages > 1 && (
                <div className="flex items-center justify-between mt-4">
                  <p className="text-sm text-muted-foreground">
                    Showing {(page - 1) * PER_PAGE + 1} to {Math.min(page * PER_PAGE, filtered.length)} of {filtered.length} results
                  </p>
                  <div className="flex gap-1">
                    <button
                      onClick={() => setPage((p) => Math.max(1, p - 1))}
                      disabled={page === 1}
                      className="px-3 py-1.5 text-sm rounded-lg border disabled:opacity-50 hover:bg-muted transition-colors"
                    >
                      <ChevronLeft className="h-4 w-4" />
                    </button>
                    {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
                      let p: number;
                      if (totalPages <= 5) p = i + 1;
                      else if (page <= 3) p = i + 1;
                      else if (page >= totalPages - 2) p = totalPages - 4 + i;
                      else p = page - 2 + i;
                      return (
                        <button
                          key={p}
                          onClick={() => setPage(p)}
                          className={`w-8 h-8 text-sm rounded-lg transition-colors ${page === p ? 'bg-bitcoin text-white' : 'hover:bg-muted'}`}
                        >
                          {p}
                        </button>
                      );
                    })}
                    <button
                      onClick={() => setPage((p) => Math.min(totalPages, p + 1))}
                      disabled={page === totalPages}
                      className="px-3 py-1.5 text-sm rounded-lg border disabled:opacity-50 hover:bg-muted transition-colors"
                    >
                      <ChevronRight className="h-4 w-4" />
                    </button>
                  </div>
                </div>
              )}
            </div>

            {/* AD INLINE */}
            <div className="rounded-xl border border-dashed border-muted-foreground/20 bg-muted/30 py-4 px-4 text-center my-6">
              <span className="text-sm text-muted-foreground">📢 اشتہار — </span>
              <Link href="/advertise" className="text-sm text-bitcoin hover:underline">یہاں اشتہار لگائیں</Link>
            </div>

            {/* TRENDING */}
            <div>
              <h2 className="text-xl font-bold mb-4">⚡ Trending Coins</h2>
              <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {(trendingItems as Record<string, unknown>[]).slice(0, 6).map((item, i: number) => {
                  const c = item.item as Record<string, unknown> | undefined;
                  if (!c) return null;
                  return (
                  <Link
                    key={(c.id as string) || i}
                    href={`/coins/${c.id}`}
                    className="rounded-xl border bg-card p-4 hover:shadow-md transition-all hover:border-bitcoin/30"
                  >
                    <div className="flex items-center gap-2 mb-2">
                      <Image
                        src={c.small as string}
                        alt={c.name as string}
                        width={32}
                        height={32}
                        className="rounded-full"
                      />
                      <div>
                        <div className="font-semibold text-sm">{c.name as string}</div>
                        <div className="text-xs text-muted-foreground">{c.symbol as string}</div>
                      </div>
                    </div>
                    <div className="text-xs text-muted-foreground">Rank #{String((c.market_cap_rank as number) ?? '—')}</div>
                    <div className="text-xs text-muted-foreground mt-1">🔥 Trending #{i + 1}</div>
                  </Link>
                  );
                })}
              </div>
            </div>
          </div>

          {/* BOTTOM AD */}
          <div className="rounded-xl border border-dashed border-muted-foreground/20 bg-muted/30 py-6 px-4 text-center">
            <span className="text-sm text-muted-foreground">📢 اشتہار — </span>
            <Link href="/advertise" className="text-sm text-bitcoin hover:underline">یہاں اشتہار لگائیں</Link>
          </div>
        </div>
      </div>
    </div>
  );
}

function QuickConverter({ coins }: { coins: (Record<string, unknown> & { usd_price: number })[] }) {
  const [amount, setAmount] = useState(1);
  const [from, setFrom] = useState('usd');
  const [to, setTo] = useState('pkr');
  const [rates, setRates] = useState<Record<string, number>>({});
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    setLoading(true);
    fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,tether-gold,eur,gbp,aed,silver&vs_currencies=usd')
      .then((r) => r.json())
      .then((data: Record<string, Record<string, number>>) => {
        const r: Record<string, number> = {
          bitcoin: data.bitcoin?.usd || 76000,
          ethereum: data.ethereum?.usd || 2100,
          gold: data['tether-gold']?.usd || 4500,
          silver: data.silver?.usd || 30,
          eur: data.eur?.usd || 1.08,
          gbp: data.gbp?.usd || 1.27,
          aed: data.aed?.usd || 0.27,
          usd: 1,
          pkr: 1 / 278,
        };
        setRates(r);
        setLoading(false);
      })
      .catch(() => {
        setRates({
          bitcoin: 76000, ethereum: 2100, gold: 4500, silver: 30,
          eur: 1.08, gbp: 1.27, aed: 0.27, usd: 1, pkr: 1 / 278,
        });
        setLoading(false);
      });
  }, []);

  useEffect(() => {
    const interval = setInterval(() => {
      fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,tether-gold,eur,gbp,aed,silver&vs_currencies=usd')
        .then((r) => r.json())
        .then((data: Record<string, Record<string, number>>) => {
          setRates({
            bitcoin: data.bitcoin?.usd || 76000,
            ethereum: data.ethereum?.usd || 2100,
            gold: data['tether-gold']?.usd || 4500,
            silver: data.silver?.usd || 30,
            eur: data.eur?.usd || 1.08,
            gbp: data.gbp?.usd || 1.27,
            aed: data.aed?.usd || 0.27,
            usd: 1,
            pkr: 1 / 278,
          });
        })
        .catch(() => {});
    }, 60000);
    return () => clearInterval(interval);
  }, []);

  const toUSD = (val: number, cur: string) => {
    if (cur === 'usd') return val;
    if (cur === 'pkr') return val * (rates.pkr || 1 / 278);
    return val * (rates[cur] || 1);
  };

  const fromUSD = (val: number, cur: string) => {
    if (cur === 'usd') return val;
    if (cur === 'pkr') return val / (rates.pkr || 1 / 278);
    return val / (rates[cur] || 1);
  };

  const usdVal = toUSD(amount, from);
  const result = fromUSD(usdVal, to);

  const sym = (c: string) => {
    if (c === 'pkr') return '₨';
    if (c === 'usd') return '$';
    if (c === 'bitcoin') return '₿';
    if (c === 'ethereum') return 'Ξ';
    if (c === 'gold') return '🥇';
    if (c === 'silver') return '🥈';
    if (c === 'eur') return '€';
    if (c === 'gbp') return '£';
    if (c === 'aed') return 'د.إ';
    return '';
  };

  const label = (c: string) => {
    if (c === 'pkr') return 'PKR';
    if (c === 'usd') return 'USD';
    if (c === 'bitcoin') return 'BTC';
    if (c === 'ethereum') return 'ETH';
    if (c === 'gold') return 'Gold (oz)';
    if (c === 'silver') return 'Silver (oz)';
    if (c === 'eur') return 'EUR';
    if (c === 'gbp') return 'GBP';
    if (c === 'aed') return 'AED';
    return c;
  };

  return (
    <div className="rounded-xl border bg-card p-4">
      <div className="flex items-center justify-between mb-3">
        <h3 className="font-semibold">Quick Converter</h3>
        {loading && <span className="text-xs text-muted-foreground">Updating...</span>}
      </div>
      <div className="space-y-3">
        <div>
          <label className="text-xs text-muted-foreground mb-1 block">Amount</label>
          <input
            type="number"
            value={amount}
            onChange={(e) => setAmount(parseFloat(e.target.value) || 0)}
            className="w-full px-3 py-2 rounded-lg border bg-background text-sm focus:outline-none focus:ring-2 focus:ring-bitcoin/50"
          />
        </div>
        <div>
          <label className="text-xs text-muted-foreground mb-1 block">From</label>
          <select
            value={from}
            onChange={(e) => setFrom(e.target.value)}
            className="w-full px-3 py-2 rounded-lg border bg-background text-sm focus:outline-none"
          >
            <option value="usd">USD ($)</option>
            <option value="pkr">PKR (₨)</option>
            <option value="eur">EUR (€)</option>
            <option value="gbp">GBP (£)</option>
            <option value="aed">AED (د.إ)</option>
            <option value="bitcoin">Bitcoin (BTC)</option>
            <option value="ethereum">Ethereum (ETH)</option>
            <option value="gold">Gold (oz)</option>
            <option value="silver">Silver (oz)</option>
          </select>
        </div>
        <div>
          <label className="text-xs text-muted-foreground mb-1 block">To</label>
          <select
            value={to}
            onChange={(e) => setTo(e.target.value)}
            className="w-full px-3 py-2 rounded-lg border bg-background text-sm focus:outline-none"
          >
            <option value="pkr">PKR (₨)</option>
            <option value="usd">USD ($)</option>
            <option value="eur">EUR (€)</option>
            <option value="gbp">GBP (£)</option>
            <option value="aed">AED (د.إ)</option>
            <option value="bitcoin">Bitcoin (BTC)</option>
            <option value="ethereum">Ethereum (ETH)</option>
            <option value="gold">Gold (oz)</option>
            <option value="silver">Silver (oz)</option>
          </select>
        </div>
        <div className="bg-muted rounded-lg p-3 text-center">
          <div className="text-xs text-muted-foreground">{label(from)} → {label(to)}</div>
          <div className="text-xl font-bold mt-1">
            {sym(to)} {result > 1000 ? result.toLocaleString('en-PK', { maximumFractionDigits: 2 }) : result.toFixed(6)}
          </div>
        </div>
        <div className="text-xs text-muted-foreground text-center space-y-0.5">
          <div>1 BTC = {sym('pkr')}{formatPKR(rates.bitcoin * 278)}</div>
          <div>1 ETH = {sym('pkr')}{formatPKR(rates.ethereum * 278)}</div>
          <div>1 Gold oz = {sym('pkr')}{formatPKR(rates.gold * 278)}</div>
          <div>1 USD = {sym('pkr')}{formatPKR(278)}</div>
        </div>
      </div>
    </div>
  );
}

function formatPKR(n: number): string {
  if (!n || isNaN(n)) return '₨0';
  if (n >= 1e12) return `₨${(n / 1e12).toFixed(2)}T`;
  if (n >= 1e9) return `₨${(n / 1e9).toFixed(2)}B`;
  if (n >= 1e6) return `₨${(n / 1e6).toFixed(2)}M`;
  if (n >= 1) return `₨${n.toLocaleString('en-PK', { maximumFractionDigits: 2 })}`;
  return `₨${n.toFixed(6)}`;
}

function formatUSD(n: number): string {
  if (!n || isNaN(n)) return '$0';
  if (n >= 1) return `$${n.toLocaleString('en-US', { maximumFractionDigits: 2 })}`;
  return `$${n.toFixed(6)}`;
}

function pctClass(v: number | undefined): string {
  if (!v) return 'text-muted-foreground';
  return v >= 0 ? 'text-crypto-green' : 'text-crypto-red';
}

function pctStr(v: number | undefined): string {
  if (!v && v !== 0) return '—';
  return `${v >= 0 ? '+' : ''}${v.toFixed(2)}%`;
}
